{
  "name": "webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "fix:enc": "node scripts/fix-encoding.mjs",
    "check": "node scripts/fix-encoding.mjs && node scripts/check-jsx-escapes.mjs && tsc -b --pretty false && vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:data": "python ../scripts/export_phase3_data.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "maplibre-gl": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
